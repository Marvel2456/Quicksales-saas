{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quicksales",
  "version": "0.1.0",
  "identifier": "com.quicksales.pos",
  "build": {
    "frontendDist": "../staticfiles",
    "devUrl": "http://localhost:8000/account/login/"
  },
  "app": {
    "windows": [
      {
        "title": "Quicksales POS",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "url": "https://marvexqs.com/account/login/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
